#!/usr/bin/env bash
# Aloha! This file is to setup some top level experiment options
#
# shellcheck disable=all
export NET=rrfs                    # rrfs, rtma,
export MESH_NAME=eu12km         # conus12km, conus3km, na12km, eu12km, etc
export WGF="enkf"   # working group function = "det", "enkf", "ens", "firewx"
export VERSION=$(cat ./VERSION)
export EXP_NAME=mtgirs_eu12km
export TAG=e12km
export OPSROOT=/gpfs/f7/wrfruc/scratch/Sijie.Pan/AR3.5KM/OPSROOT/${EXP_NAME}
export EXPDIR=${OPSROOT}/exp/${NET}${WGF}
export COMROOT=${OPSROOT}/com      # task input and output data as well as logs
export DATAROOT=${OPSROOT}/stmp    # task workdirs ($DATA) which to be removed immediately upon task completion unless KEEPDATA=YES
#
export DO_ENSEMBLE=true
export DO_ENSMEAN_POST=false
export IC_ONLY=false  # interpolate GEFS/GDAS to the target mesh to provide ensemble BEC
export DO_DETERMINISTIC=false
export ENS_SIZE=30
export ZETA_LEVELS="L65.txt"
export USE_MERRA2=false  # false: default GOCART aerosol climatology; true: MERRA2 aerosol climatology
#
export DO_IODA=true
export DO_JEDI=true
export GETKF_ONESTEP=true
export DO_NONVAR_CLOUD_ANA=false
export COLDSTART_CYCS_DO_DA=false
export DO_RECENTER=false
export RECENTER_TEMPLATE=CONTROL
export DO_RADAR_REF=false
export SAVE_GETKF_ANL=false
export SAT_USELIST="mtg_irs"

# MTG-IRS observation configuration
export DO_MTGIRS=true
export JEDI_POLYGON_FILTER=false
export MTG_IRS_QUADRANTS="Q3 Q4"
export MTG_IRS_WINDOW=15
export MTG_IRS_RESOLUTION=16

export DO_CYC=true
export CYC_INTERVAL=1
for i in {0..23};    do arr[${i}]="03"; done # 3hr fcst
for i in {0..23..6}; do arr[${i}]="12"; done # 12hr fcst every 6hrs
export FCST_LEN_HRS_CYCLES="${arr[*]}"
export HISTORY_INTERVAL=1
export DIAG_INTERVAL=1
export MPASOUT_TIMELEVELS="0 1"
export POST_GROUP_TOT_NUM=1

export IC_OFFSET=6
export LBC_OFFSET=6
export LBC_LENGTH=18
export LBC_INTERVAL=1
export LBC_UNGRIB_GROUP_TOTAL_NUM=1
export LBC_GROUP_TOTAL_NUM=1

export RETRO_PERIOD="2021062406-2021062412"
export LBC_CYCS="00 06 12 18"

export DO_GRAPHICS=true
export GRAPHICS_TILES="full"
export GRAPHICS_MODEL=${TAG}

# Set up IC, LBC, and Obs sources based on machine and realtime/retro
export IC_EXTRN_MDL_NAME="GFS"
export IC_EXTRN_MDL_FILENAME_PATTERN="gfs.@Y@m@d/@H/gfs.t@Hz.pgrb2.0p25.f^HHH^"
export IC_EXTRN_MDL_FILENAME_PATTERN_B="gfs.@Y@m@d/@H/gfs.t@Hz.pgrb2b.0p25.f^HHH^"
export LBC_EXTRN_MDL_NAME=${IC_EXTRN_MDL_NAME}
export LBC_EXTRN_MDL_FILENAME_PATTERN=${IC_EXTRN_MDL_FILENAME_PATTERN}
export LBC_EXTRN_MDL_FILENAME_PATTERN_B=${IC_EXTRN_MDL_FILENAME_PATTERN_B}

case ${MACHINE} in
  "hera")
    export IC_EXTRN_MDL_BASEDIR="/scratch4/BMC/rtrr/RRFS2_RETRO_DATA/May2024/GFS"
    export LBC_EXTRN_MDL_BASEDIR=${IC_EXTRN_MDL_BASEDIR}
    export OBSPATH="/scratch4/BMC/rtrr/RRFS2_RETRO_DATA/May2024/obs_rap"
    export OBSPATH_NSSLMOSAIC="/scratch4/BMC/rtrr/RRFS2_RETRO_DATA/May2024/reflectivity"
    export OBSPATH_AIRNOW="/scratch4/BMC/rtrr/RRFS2_RETRO_DATA/May2024/airnow"
    export OBSPATH_MTGIRS=""
    export ACCOUNT="wrfruc"
    export QUEUE="batch"
    export PARTITION="hera"
    export NODES_IODA_MTGIRS="<nodes>1:ppn=40</nodes>"
    ;;
  "orion"|"hercules")
    export IC_EXTRN_MDL_BASEDIR="/work2/noaa/wrfruc/RRFS2_RETRO_DATA/May2024/GFS"
    export LBC_EXTRN_MDL_BASEDIR=${IC_EXTRN_MDL_BASEDIR}
    export OBSPATH="/work2/noaa/wrfruc/RRFS2_RETRO_DATA/May2024/obs_rap"
    export OBSPATH_NSSLMOSAIC="/work2/noaa/wrfruc/RRFS2_RETRO_DATA/May2024/reflectivity"
    export OBSPATH_AIRNOW="/work2/noaa/wrfruc/RRFS2_RETRO_DATA/May2024/airnow"
    export OBSPATH_MTGIRS=""
    export ACCOUNT="wrfruc"
    export QUEUE="batch"
    export PARTITION=${MACHINE}
    export CLUSTER=""
    export NODES_IODA_MTGIRS="<nodes>1:ppn=40</nodes>"
    if [[ "${MACHINE}" == "hercules" ]]; then
      export NODES_IODA_MTGIRS="<nodes>1:ppn=80</nodes>"
    fi
    ;;
  "ursa")
    if [[ "${REALTIME^^}" == "TRUE" ]]; then
      export IC_EXTRN_MDL_BASEDIR="/public/data/grids/gfs/ncep"
      export LBC_EXTRN_MDL_BASEDIR=${IC_EXTRN_MDL_BASEDIR}
      export OBSPATH="/public/data/grids/rap/obs"
      export OBSPATH_NSSLMOSAIC="/public/data/radar/mrms"
      export OBSPATH_MTGIRS=""
      export ACCOUNT="rtwrfruc"
      export QUEUE="hpq"
    else
      export IC_EXTRN_MDL_BASEDIR="/scratch4/BMC/rtrr/RRFS2_RETRO_DATA/May2024/GFS"
      export LBC_EXTRN_MDL_BASEDIR=${IC_EXTRN_MDL_BASEDIR}
      export OBSPATH="/scratch4/BMC/rtrr/RRFS2_RETRO_DATA/May2024/obs_rap"
      export OBSPATH_NSSLMOSAIC="/scratch4/BMC/rtrr/RRFS2_RETRO_DATA/May2024/reflectivity"
      export OBSPATH_AIRNOW="/scratch4/BMC/rtrr/RRFS2_RETRO_DATA/May2024/airnow"
      export OBSPATH_MTGIRS=""
      export ACCOUNT="wrfruc"
      export QUEUE="batch"
    fi
    export PARTITION="u1-compute"
    export NODES_IODA_MTGIRS="<nodes>1:ppn=80</nodes>"
    ;;
  "gaeac6")
    if [[ "${REALTIME^^}" == "TRUE" ]]; then
      export IC_EXTRN_MDL_BASEDIR="/gpfs/f6/gsl-data-depot/world-shared/data/grids/gfs"
      export LBC_EXTRN_MDL_BASEDIR=${IC_EXTRN_MDL_BASEDIR}
      export OBSPATH="/gpfs/f6/gsl-data-depot/world-shared/data/grids/rap/obs"
      export OBSPATH_NSSLMOSAIC="/gpfs/f6/gsl-data-depot/world-shared/data/radar/mrms"
      export OBSPATH_MTGIRS=""
      export ACCOUNT="bil-fire10-oar"
      export QUEUE="normal"
    else
      export IC_EXTRN_MDL_BASEDIR="/gpfs/f6/bil-fire10-oar/world-shared/RRFS2_RETRO_DATA/May2024/GFS"
      export LBC_EXTRN_MDL_BASEDIR=${IC_EXTRN_MDL_BASEDIR}
      export OBSPATH="/gpfs/f6/bil-fire10-oar/world-shared/RRFS2_RETRO_DATA/May2024/obs_rap"
      export OBSPATH_NSSLMOSAIC="/gpfs/f6/bil-fire10-oar/world-shared/RRFS2_RETRO_DATA/May2024/reflectivity"
      export OBSPATH_AIRNOW="/gpfs/f6/bil-fire10-oar/world-shared/RRFS2_RETRO_DATA/May2024/airnow"
      export OBSPATH_MTGIRS=""
      export ACCOUNT="bil-fire10-oar"
      export QUEUE="normal"
    fi
    export PARTITION="batch"
    export CLUSTER="c6"
    export NODES_IODA_MTGIRS="<nodes>1:ppn=192</nodes>"
    ;;
  "gaeac7")
    export IC_EXTRN_MDL_BASEDIR="/gpfs/f7/wrfruc/world-shared/RRFS2_RETRO_DATA/May2024/GFS"
    export LBC_EXTRN_MDL_BASEDIR=${IC_EXTRN_MDL_BASEDIR}
    export OBSPATH="/gpfs/f7/wrfruc/world-shared/RRFS2_RETRO_DATA/May2024/obs_rap"
    export OBSPATH_NSSLMOSAIC="/gpfs/f7/wrfruc/world-shared/RRFS2_RETRO_DATA/May2024/reflectivity"
    export OBSPATH_AIRNOW="/gpfs/f7/wrfruc/world-shared/RRFS2_RETRO_DATA/May2024/airnow"
    export OBSPATH_MTGIRS=""
    export ACCOUNT="bil-fire10-oar"
    export QUEUE="normal"
    export PARTITION="batch"
    export CLUSTER="c7"
    export NODES_IODA_MTGIRS="<nodes>1:ppn=384</nodes>"
    ;;
  "wcoss2")
    export IC_EXTRN_MDL_BASEDIR="/lfs/h2/emc/lam/noscrub/RRFS2_RETRO_DATA/May2024/GFS"
    export LBC_EXTRN_MDL_BASEDIR=${IC_EXTRN_MDL_BASEDIR}
    export OBSPATH="/lfs/h2/emc/lam/noscrub/RRFS2_RETRO_DATA/May2024/obs_rap"
    export OBSPATH_NSSLMOSAIC="/lfs/h2/emc/lam/noscrub/RRFS2_RETRO_DATA/May2024/reflectivity"
    export OBSPATH_AIRNOW="/lfs/h2/emc/lam/noscrub/RRFS2_RETRO_DATA/May2024/airnow"
    export OBSPATH_MTGIRS=""
    export ACCOUNT="RRFS-DEV"
    export QUEUE="dev"
    export PARTITION=""
    export NODES_IODA_MTGIRS="<nodes>1:ppn=128</nodes>"
    ;;
esac
